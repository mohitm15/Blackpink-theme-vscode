  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment.block.php",
        "punctuation.definition.comment.documentation.cpp",
        "punctuation.definition.comment",
        "comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#F5BCCA99"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FFEEF7"
      }
    },
    {
      "name": "String constant",
      "scope": [
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#fa71ff"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "storage.modifier",
        "storage.type",
        "keyword"
      ],
      "settings": {
        "foreground": "#ff0062"
      }
    },
    {
      "name": "Operator, Misc",
      "scope": [
        "keyword.operator.logical.js",
        "keyword.other.substitution",
        "keyword.other.template",
        "punctuation.section.embedded",
        "punctuation.definition.tag.end.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.html",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00fff2"
      }
    },
    {
      "name": "Operator, Misc",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ff006a"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "markup.deleted.git_gutter",
        "meta.tag.sgml",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff0077"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "keyword.other.special-method",
        "support.function",
        "variable.function",
        "meta.function-call.generic.python",
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#DA7CEF"
      }
    },
    {
      "name": "Special Method",
      "scope": [
        "support.function.builtin.js",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#20dd20"
      }
    },
    {
      "name": "Block Level Variables",
      "scope": [
        "meta.block variable.other"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "string.other.link",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
      "scope": [
        "variable.parameter",
        "constant.escape",
        "constant.character",
        "support.constant",
        "constant.language",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF4387"
      }
    },
    {
      "name": "Tag Attribute, Embedded",
